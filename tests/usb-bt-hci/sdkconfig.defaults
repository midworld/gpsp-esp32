CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_GPSP_USB_PAD=y
CONFIG_GPSP_USB_BT=y
# CONFIG_GPSP_AUDIO is not set
# CONFIG_GPSP_STATUS is not set
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y
# CONFIG_BT_BLUEDROID_ESP_COEX_VSC is not set
CONFIG_BT_ENC_KEY_SIZE_CTRL_NONE=y
# CONFIG_BT_BLE_ENABLED is not set
