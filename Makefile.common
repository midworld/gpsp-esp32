
LIBRETRO_COMM_DIR := $(CORE_DIR)/libretro/libretro-common
INCFLAGS   := -I$(CORE_DIR)/libretro -I$(LIBRETRO_COMM_DIR)/include -I$(CORE_DIR)/include -I$(CORE_DIR)/

SOURCES_ASM := $(CORE_DIR)/bios_data.S

SOURCES_CC := $(CORE_DIR)/video.cc \
              $(CORE_DIR)/cpu.cc

SOURCES_C := $(CORE_DIR)/main.c \
             $(CORE_DIR)/gba_memory.c \
             $(CORE_DIR)/gba_rom_scan.c \
             $(CORE_DIR)/savestate.c \
             $(CORE_DIR)/input.c \
             $(CORE_DIR)/sound.c \
             $(CORE_DIR)/cheats.c \
             $(CORE_DIR)/memmap.c \
             $(CORE_DIR)/serial.c \
             $(CORE_DIR)/gbp.c \
             $(CORE_DIR)/rfu.c \
             $(CORE_DIR)/serial_proto.c \
             $(CORE_DIR)/libretro/libretro.c \
             $(CORE_DIR)/gba_cc_lut.c \
             $(LIBRETRO_COMM_DIR)/compat/compat_posix_string.c \
             $(LIBRETRO_COMM_DIR)/compat/compat_strl.c \
             $(LIBRETRO_COMM_DIR)/compat/fopen_utf8.c \
             $(LIBRETRO_COMM_DIR)/encodings/encoding_utf.c \
             $(LIBRETRO_COMM_DIR)/file/file_path.c \
             $(LIBRETRO_COMM_DIR)/file/file_path_io.c \
             $(LIBRETRO_COMM_DIR)/streams/file_stream.c \
             $(LIBRETRO_COMM_DIR)/string/stdstring.c \
             $(LIBRETRO_COMM_DIR)/time/rtime.c \
             $(LIBRETRO_COMM_DIR)/vfs/vfs_implementation.c

# Accept both environment settings and make command-line assignments.
GPSP_ISA_OPTIONS := GPSP_RV32_USE_ZBA GPSP_RV32_USE_ZBB GPSP_RV32_USE_ZBS \
                    GPSP_RV32_USE_RVC GPSP_RV32_USE_ZCB
GPSP_BENCH_OPTIONS := GPSP_BENCHMARK_PHASE_WORK GPSP_BENCHMARK_INSTRET \
                      GPSP_BENCHMARK_JIT_DETAIL GPSP_BENCHMARK_JIT_LOOKUP \
                      GPSP_BENCHMARK_JIT_MISS_CLASS GPSP_BENCHMARK_JIT_CODE_BYTES \
                      GPSP_BENCHMARK_VIDEO_DETAIL GPSP_BENCHMARK_RAM_CODE
GPSP_BOOL_OPTIONS := $(GPSP_ISA_OPTIONS) $(GPSP_BENCH_OPTIONS) \
                     GPSP_BENCHMARK \
                     GPSP_AFFINE_PIE
$(foreach option,$(GPSP_BOOL_OPTIONS),$(if $(filter-out 0 1,$($(option)))$(word 2,$($(option))),$(error $(option) must be 0 or 1)))

DEFINES += $(foreach option,$(GPSP_ISA_OPTIONS),$(if $(strip $($(option))),-D$(option)=$($(option))))
GPSP_SIZE_OPTIONS := GPSP_RV32_ROM_CACHE_KIB GPSP_RV32_RAM_CACHE_KIB \
                     GPSP_RV32_CODE_CHUNK_KIB ROM_BUFFER_SIZE
DEFINES += $(foreach option,$(GPSP_SIZE_OPTIONS),$(if $(strip $($(option))),-D$(option)=$($(option))))

ifneq ($(filter 1,$(foreach option,$(GPSP_BENCH_OPTIONS),$($(option)))),)
  ifneq ($(GPSP_BENCHMARK),1)
    $(error Benchmark detail options require GPSP_BENCHMARK=1)
  endif
endif
DEFINES += $(foreach option,$(GPSP_BENCH_OPTIONS),$(if $(filter 1,$($(option))),-D$(option)=1))

ifeq ($(HAVE_DYNAREC), 1)
  SOURCES_C += $(CORE_DIR)/cpu_threaded.c
  ifeq ($(CPU_ARCH), x86_32)
    SOURCES_ASM += $(CORE_DIR)/x86/x86_stub.S
  else ifeq ($(CPU_ARCH), arm)
    SOURCES_ASM += $(CORE_DIR)/arm/arm_stub.S
  else ifeq ($(CPU_ARCH), arm64)
    SOURCES_ASM += $(CORE_DIR)/arm/arm64_stub.S
  else ifeq ($(CPU_ARCH), mips)
    SOURCES_ASM += $(CORE_DIR)/mips/mips_stub.S
  endif
endif

ifeq ($(platform), rv32)
  ifeq ($(HAVE_DYNAREC), 1)
    $(error RV32 JIT requires HAVE_DYNAREC=0)
  endif
  DEFINES += -DGPSP_RV32_JIT=1
  SOURCES_C += $(CORE_DIR)/riscv/rv32_arm_alu.c \
               $(CORE_DIR)/riscv/rv32_arm_branch.c \
               $(CORE_DIR)/riscv/rv32_arm_mul.c \
               $(CORE_DIR)/riscv/rv32_codegen.c \
               $(CORE_DIR)/riscv/rv32_fallback.c \
               $(CORE_DIR)/riscv/rv32_platform.c \
               $(CORE_DIR)/riscv/rv32_thumb_alu.c
  SOURCES_ASM += $(CORE_DIR)/riscv/rv32_stub.S
  SOURCES_C += $(CORE_DIR)/cpu_threaded.c \
               $(CORE_DIR)/riscv/rv32_arm_memory.c \
               $(CORE_DIR)/riscv/rv32_arm_system.c \
               $(CORE_DIR)/riscv/rv32_block_emit.c \
               $(CORE_DIR)/riscv/rv32_block_link.c \
               $(CORE_DIR)/riscv/rv32_ram_units.c \
               $(CORE_DIR)/riscv/rv32_thumb_memory.c \
               $(CORE_DIR)/riscv/rv32_flow_timing.c \
               $(CORE_DIR)/riscv/rv32_arm_flow_alu.c \
               $(CORE_DIR)/riscv/rv32_arm_flow_full.c \
               $(CORE_DIR)/riscv/rv32_thumb_flow_full.c
  SOURCES_CC += $(CORE_DIR)/riscv/rv32_block_runtime.cc
  SOURCES_ASM += $(CORE_DIR)/riscv/rv32_arm_io.S \
                 $(CORE_DIR)/riscv/rv32_arm_palette.S \
                 $(CORE_DIR)/riscv/rv32_interpreter_stub.S \
                 $(CORE_DIR)/riscv/rv32_rom_load.S \
                 $(CORE_DIR)/riscv/rv32_thumb_multi_ram.S \
                 $(CORE_DIR)/riscv/rv32_thumb_ram_helper.S \
                 $(CORE_DIR)/riscv/rv32_thumb_ram_store.S \
                 $(CORE_DIR)/riscv/rv32_thumb_exit_shared.S
endif

ifeq ($(GPSP_BENCHMARK), 1)
  DEFINES += -DGPSP_BENCHMARK=1
  SOURCES_C += $(CORE_DIR)/gpsp_benchmark_timing.c
endif

# Requires an assembler and CPU with the XespV extension.
ifeq ($(GPSP_AFFINE_PIE), 1)
  DEFINES += -DGPSP_AFFINE_PIE=1
  SOURCES_ASM += $(CORE_DIR)/riscv/rv32_affine_pie.S
endif

